<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Strong.Pages.StudentsPages.ExercisePage"
             Title="ExercisePage">


    <StackLayout Orientation="Vertical" >
            
        <CollectionView ItemsSource="{Binding ExerciseList}" SelectedItem="{Binding Select}" >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" Padding="5">
                        <Label Text="{Binding exercise_name}"  FontSize="18" VerticalOptions="Center"  Margin="5" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>



</ContentPage>
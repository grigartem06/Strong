<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Strong.Pages.StudentsPages.AboutTrainingPage"
             Title="AboutTrainingPage">

    <ScrollView>
        <StackLayout Orientation="Vertical">

            <CollectionView ItemsSource="{Binding SetsList}" SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        
                        
                        <StackLayout Orientation="Horizontal" Padding="5">
                            <Label Text="{Binding exercise_id}"  FontSize="18" VerticalOptions="Center"  Margin="5" />
                            <Entry Text="{Binding exercise_weight}" FontSize="18" VerticalOptions="Center"  Margin="5" TextChanged="{Binding TextChangedCommand}"/>
                            <Entry Text="{Binding exercise_reps}" FontSize="18" VerticalOptions="Center"  Margin="5" TextChanged="{Binding TextChangedCommand}"/>
                            <Entry Text="{Binding rest_time}" FontSize="18" VerticalOptions="Center"  Margin="5" TextChanged="{Binding TextChangedCommand}"/>
                            <Button Text="Save"  Command="{Binding SaveChancedCommand}" Margin="5" IsVisible="Collapse" x:Name="SaveBtn"/>
                        </StackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


        </StackLayout>
    </ScrollView>
    
</ContentPage>
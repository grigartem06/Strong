<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Strong.Pages.StudentsPages.StudentMainPage"
             Title="StudentMainPage">

    <StackLayout Orientation="Vertical" Padding="10">
        <Label Text="{Binding Test}"/>

        <Button  Text="замеры" Command="{Binding GoToMeasurementsPageCommand}" Margin="5"/> 
        <Button  Text="упражнения" Command="{Binding GoToExercisePageCommand}" Margin="5"/>
        <Button  Text="новая тренировка" Command="{Binding GoToNewTrainingPageCommand}" Margin="5"/> 
        <Button  Text="шаблоны" Command="{Binding}" Margin="5"/> 
        <Button  Text="история" Command="{Binding}" Margin="5"/>


        <Button Text="выйти" Command="{Binding BackCommand}"/>
    </StackLayout>
    
    
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Strong.Pages.StudentsPages.NewTrainingPage"
             Title="NewTrainingPage">


    <ScrollView>
        <StackLayout Orientation="Vertical">

            <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                <Label Text="название тренировки" />
                <Entry Text="{Binding TrainingName}" />
            </StackLayout>

            <CollectionView ItemsSource="{Binding ExerciseSections}" SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <StackLayout  Orientation="Horizontal"> 
                            <Label Text="{Binding exercise_id, Mode=TwoWay}" Margin="5"/>
                            <Entry Text="{Binding exercise_weight, Mode=TwoWay}" Margin="5"/>
                            <Entry Text="{Binding exercise_reps, Mode=TwoWay}" Margin="5"/>
                            <Entry Text="{Binding rest_time, Mode=TwoWay}" Margin="5"/>
                        </StackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
            </CollectionView>

            <Button Text="добавить упражнение" Command="{Binding AddExerciseToTrainingCommand}" Margin="5"/>
            <Button Text="сохранить" Command="{Binding SaveTrainingCommand} "/>
            <Button Text="отменить" Command="{Binding CancelTrainingCommand}"/>

        </StackLayout>
    </ScrollView>
</ContentPage>
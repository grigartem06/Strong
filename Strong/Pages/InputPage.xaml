<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Strong.Pages.InputPage"
             Title="InputPage">

    <StackLayout Orientation="Vertical" Padding="10">
        <Label Text="войти"  HorizontalOptions="Center"  Margin="5"/>
        <Entry Text="{Binding UserName}"  HorizontalTextAlignment="Center" Placeholder="Введите имя"/>
        <Entry Text="{Binding Password}"  HorizontalTextAlignment="Center" Placeholder="Введите пароль" IsPassword="True"/>

        <Button Text="войти"  Command="{Binding InputCommand}" Margin="5" />

        <Label Text="нет аккаунта" FontSize="Small" Margin="5" HorizontalTextAlignment="Center"/>
        <Button Text="зарегистроваться"  Command="RegistrationCommand" Margin="5"/>

    </StackLayout>
</ContentPage>
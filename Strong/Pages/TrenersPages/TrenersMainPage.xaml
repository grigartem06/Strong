<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Strong.Pages.TrenersPages.TrenersMainPage"
             Title="TrenersMainPage">

    <ScrollView Orientation="Vertical">
        
        <StackLayout Orientation="Vertical" Padding="10">

            <Label Text="ваши ученики:"  HorizontalTextAlignment="Center" FontSize="Header"/>
            
            <CollectionView ItemsSource="{Binding StudentsList}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Orientation="Horizontal" Padding="5">
                            <Label Text="{Binding UserName}" FontSize="18" VerticalOptions="Center" />
                            <Button Text="подробнее" Command="{Binding }"/>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button  Text="добавить ученика" Margin="5" Command="{Binding }"/>
            

        </StackLayout>
        
    </ScrollView>
</ContentPage>